{
  "name": "smaht-im",
  "version": "0.2.0",
  "description": "SMaHT Inserts Manager — TUI and CLI tools for smaht-portal inserts",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "imc": "./bin/imc.js"
  },
  "scripts": {
    "build": "esbuild src/index.jsx --bundle --packages=external --platform=node --format=esm --outfile=dist/imc.js",
    "watch": "esbuild src/index.jsx --bundle --packages=external --platform=node --format=esm --outfile=dist/imc.js --watch",
    "start": "node dist/imc.js",
    "dev": "npm run build && esbuild src/index.jsx --bundle --packages=external --platform=node --format=esm --outfile=dist/imc.js --watch >/dev/null 2>&1 & ESBUILD_PID=$! && node --watch-path=dist dist/imc.js; kill $ESBUILD_PID 2>/dev/null",
    "test": "node --test test/*.test.js",
    "test:py": "python3 -m unittest discover -s test -p 'test_*.py' -v",
    "test:all": "npm test && npm run test:py"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "ink-testing-library": "^4.0.0"
  }
}
